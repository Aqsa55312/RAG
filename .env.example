# ==============================================================================
# Enterprise RAG Configuration Template
# ==============================================================================

# Project & Server
APP_NAME="Enterprise Knowledge Base RAG"
APP_ENV="development"
HOST="0.0.0.0"
PORT=8000
DEBUG=true
API_PREFIX="/api/v1"

# Security & JWT Authentication
AUTH_REQUIRED=true
JWT_SECRET_KEY="super-secret-enterprise-rag-jwt-key-change-in-production"
JWT_ALGORITHM="HS256"
JWT_EXPIRATION_MINUTES=1440

# LLM Provider (Ollama)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"
OLLAMA_TEMPERATURE=0.2
OLLAMA_TOP_P=0.9
OLLAMA_MAX_TOKENS=2048
OLLAMA_CONTEXT_WINDOW=8192

# Embedding Model
OLLAMA_EMBED_MODEL="nomic-embed-text"
EMBEDDING_DIMENSION=768

# Vector Store (ChromaDB)
VECTOR_DB_TYPE="chroma"
CHROMA_PERSIST_DIRECTORY="./data/chroma_db"
CHROMA_COLLECTION_NAME="enterprise_knowledge"
DISTANCE_METRIC="cosine"

# Ingestion Pipeline & Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Confluence Connector
CONFLUENCE_ENABLED=true
CONFLUENCE_URL="https://your-domain.atlassian.net"
CONFLUENCE_USERNAME="your-email@example.com"
CONFLUENCE_API_TOKEN="your-api-token"
CONFLUENCE_DEFAULT_SPACES="ENG,HR,OPS"
CONFLUENCE_SYNC_INTERVAL_HOURS=24

# Notion Connector
NOTION_ENABLED=true
NOTION_API_KEY="secret_your_notion_api_key"
NOTION_DATABASE_IDS="database_id_sop_internal,database_id_tech_docs"
